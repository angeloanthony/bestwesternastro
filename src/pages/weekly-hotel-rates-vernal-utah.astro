---
// src/pages/weekly-hotel-rates-vernal-utah.astro
// MIGRATION of /weekly-hotel-rates-vernal-utah.html — metadata, canonical, JSON-LD schema, body copy,
// headings, and internal links preserved VERBATIM. Shared chrome
// (nav / mobile menu / footer / scroll-top + burger script) is provided by
// BaseLayout; page-specific <style>/schema go in the head slot and
// page-specific scripts in the scripts slot, both emitted unchanged.
import BaseLayout from '../layouts/BaseLayout.astro';
import { RATES, usd, LOWEST_NIGHTLY, WEEKLY_CALL_LINE } from '../data/rates.ts';
import { BUSINESS } from '../data/business.ts';

const headExtras = `<script type="application/ld+json">
 {
  "@context":"https://schema.org",
  "@type":"FAQPage",
  "mainEntity":[
   {"@type":"Question","name":"What are your weekly hotel rates?","acceptedAnswer":{"@type":"Answer","text":"Weekly rates are quoted by the front desk rather than published — call (435) 789-6625 with your dates and room type for the current weekly price. Published nightly rates start at ${LOWEST_NIGHTLY} + tax. All rates include free breakfast, WiFi, and parking."}},
    {"@type":"Question","name":"Do weekly rates include breakfast?","acceptedAnswer":{"@type":"Answer","text":"Yes. Free hot breakfast every morning for every guest, regardless of stay length."}},
    {"@type":"Question","name":"Are monthly rates available?","acceptedAnswer":{"@type":"Answer","text":"Yes. Call (435) 789-6625 for monthly pricing. We work directly with guests on longer-term rates."}},
    {"@type":"Question","name":"Can I get a kitchenette room for a weekly stay?","acceptedAnswer":{"@type":"Answer","text":"Yes. Kitchenette rooms with a refrigerator, microwave, and stovetop are available. Specify when booking to guarantee availability."}}
  ]
 }
 </script>`;
const bodyContent = `<section class="page-hero">
 <div class="page-hero-cnt">
 <p style="font-size:.85rem;letter-spacing:3px;text-transform:uppercase;margin-bottom:12px;color:var(--gold);font-weight:700;">Weekly Rates — Save More, Stay Longer</p>
 <h1 style="font-family:'Playfair Display',serif;font-size:clamp(1.8rem,4.5vw,3rem);font-weight:700;margin-bottom:18px;line-height:1.15;">Weekly Hotel Rates<br>in Vernal, Utah</h1>
 <p style="font-size:1.05rem;line-height:1.7;opacity:.88;max-width:620px;margin:0 auto 24px;font-weight:300;">Best Western Vernal Inn quotes weekly rates directly — call with your dates and room type and the front desk will give you the current price for a 7-night stay. Nightly rates start at ${LOWEST_NIGHTLY} + tax, with free hot breakfast, free WiFi, free parking, and kitchenettes included.</p>
 <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
  <a href="tel:${BUSINESS.phoneTel}" style="background:var(--gold);color:var(--navy);padding:13px 32px;border-radius:4px;text-decoration:none;font-weight:900;font-size:.85rem;letter-spacing:1.5px;text-transform:uppercase;">📞 ${BUSINESS.directBooking.ctaLabel} ${BUSINESS.directBooking.discountPercent}%</a>
  <a href="tel:${BUSINESS.phoneTel}" style="border:2px solid #fff;color:#fff;padding:12px 28px;border-radius:4px;text-decoration:none;font-weight:700;font-size:.85rem;letter-spacing:1px;">📞 (435) 789-6625</a>
 </div>
 </div>
</section>
<div class="distance-bar">💰 NIGHTLY FROM ${LOWEST_NIGHTLY} · ${WEEKLY_CALL_LINE.toUpperCase()} · BREAKFAST INCLUDED</div>
<div class="content-wrap">
<div class="intro-pull"><strong>Staying in Vernal for a week or more?</strong> Best Western Vernal Inn's weekly rates are designed for guests who need more than a night — oilfield crews, contractors, extended family visits, and recreational travelers exploring Dinosaur National Monument, Flaming Gorge, and the Uinta Mountains. The weekly price is not published here: it is set by the front desk against your dates and room type, so call ${BUSINESS.phoneDisplay} and ask. What is published is the nightly card — a Studio King at ${usd(RATES.nightly.studioKing)} ${RATES.taxNote}, a Studio Two Queen at ${usd(RATES.nightly.studioTwoQueen)} — which gives you a firm ceiling to compare the weekly quote against.</div>
<div class="content-section">
 <h2>Weekly Rate Breakdown</h2>
<div style="overflow-x:auto;margin:1.2rem 0;">
<table style="width:100%;border-collapse:collapse;font-size:.95rem;max-width:600px;">
<thead><tr style="background:var(--navy);color:#fff;">
<th style="padding:12px 16px;text-align:left;">Room Type</th>
<th style="padding:12px 16px;text-align:center;">Nightly Rate</th>
<th style="padding:12px 16px;text-align:center;">Weekly Rate (7 Nights)</th>
</tr></thead>
<tbody>
<tr style="background:#f5f4f0;"><td style="padding:11px 16px;font-weight:700;">Studio King</td><td style="padding:11px 16px;text-align:center;font-weight:900;color:var(--navy);font-size:1.05rem;">${usd(RATES.nightly.studioKing)}</td><td style="padding:11px 16px;text-align:center;">Call for price</td></tr>
<tr><td style="padding:11px 16px;font-weight:700;">Studio Two Queen</td><td style="padding:11px 16px;text-align:center;font-weight:900;color:var(--navy);font-size:1.05rem;">${usd(RATES.nightly.studioTwoQueen)}</td><td style="padding:11px 16px;text-align:center;">Call for price</td></tr>
<tr style="background:#f5f4f0;"><td style="padding:11px 16px;font-weight:700;">Handicap / Accessible Studio King</td><td style="padding:11px 16px;text-align:center;font-weight:900;color:var(--navy);font-size:1.05rem;">${usd(RATES.nightly.accessibleStudioKing)}</td><td style="padding:11px 16px;text-align:center;">Call for price</td></tr>
<tr><td style="padding:11px 16px;font-weight:700;">Pet-Friendly Studio Two Queen</td><td style="padding:11px 16px;text-align:center;font-weight:900;color:var(--navy);font-size:1.05rem;">${usd(RATES.nightly.petFriendlyStudioTwoQueen)}</td><td style="padding:11px 16px;text-align:center;">Call for price</td></tr>
<tr style="background:#f5f4f0;"><td style="padding:11px 16px;font-weight:700;">Pet-Friendly Room</td><td style="padding:11px 16px;text-align:center;font-weight:900;color:var(--navy);font-size:1.05rem;">${usd(RATES.nightly.petFriendlyRoom)}</td><td style="padding:11px 16px;text-align:center;">Call for price</td></tr>
<tr><td style="padding:11px 16px;font-weight:700;">Suites <span style="font-weight:400;color:var(--muted);font-size:.9em;">— King Suite (Kitchenette), King Jacuzzi, Jacuzzi Double Queen</span></td><td style="padding:11px 16px;text-align:center;">Call for rate</td><td style="padding:11px 16px;text-align:center;">Call for price</td></tr>
</tbody></table>
</div>
<p>Nightly rates are ${RATES.taxNote} and are the same seven days a week. The weekly price for a seven-consecutive-night stay is quoted by the front desk on ${BUSINESS.phoneDisplay} — it is not a percentage off the nightly rate, so there is no figure here to multiply. Every rate includes free hot breakfast, free WiFi, free parking and access to on-site laundry. Kitchenette rooms are available — specify when booking.</p>
</div>

<div class="content-section">
 <h2>What the Weekly Rate Actually Is</h2>
<p>It is a flat price for seven consecutive nights, not a discount code applied at checkout. It is also not published: the front desk quotes it against your dates and room type, because a week in March and a week during a drilling push are not the same booking. Call ${BUSINESS.phoneDisplay} and you will be given a firm number for the whole stay, rather than a rate to multiply by seven yourself.</p>
<p>Two things the quote does not change. Tax is added on top (${RATES.taxNote}). And the rate is quoted per room, not per person, so a Studio Two Queen covers up to four people in one room at one price.</p>
<p>The suite types — King Suite with a full kitchenette, King Jacuzzi Suite, and Jacuzzi Double Queen Suite — have no published rate at all, nightly or weekly. The front desk quotes those directly on ${BUSINESS.phoneDisplay}.</p>
</div>

<div class="content-section">
 <h2>Which Room Type Fits a Week</h2>
<ul class="feat-list">
 <li><strong>Studio King — sleeps 1–2.</strong> ${usd(RATES.nightly.studioKing)}/night ${RATES.taxNote}. The default for a solo contractor or a couple; ask for the weekly price when you call.</li>
 <li><strong>Studio Two Queen — sleeps 1–4.</strong> ${usd(RATES.nightly.studioTwoQueen)}/night ${RATES.taxNote}. Two beds, so it also works for two crew members sharing rather than booking two rooms — which is the single biggest lever on a weekly lodging bill.</li>
 <li><strong>Handicap / Accessible Studio King — sleeps 1–2.</strong> ${usd(RATES.nightly.accessibleStudioKing)}/night ${RATES.taxNote}. Roll-in shower and wide doorways, at the same rate as the Studio King.</li>
 <li><strong>King Suite with kitchenette — sleeps 1–2.</strong> Rate on request. This is the one to ask about if you intend to cook rather than eat out for seven days.</li>
</ul>
</div>

<div class="content-section">
 <h2>How a Weekly Stay Works Day to Day</h2>
<ul class="feat-list">
 <li><strong>Check-in from ${BUSINESS.hours.checkinTime}, check-out by ${BUSINESS.hours.checkoutTime}.</strong> The front desk is staffed around the clock, so an arrival outside those hours is not a problem — useful if you are driving in after a shift or a late flight into Vernal Regional.</li>
 <li><strong>On-site laundry.</strong> The practical difference between a three-night trip and a seven-night one is laundry; it is here rather than across town.</li>
 <li><strong>Free parking, including trucks and trailers.</strong> No permit, no nightly parking charge, no reservation.</li>
 <li><strong>Breakfast every morning</strong> — every day of the stay, not just the first.</li>
 <li><strong>Pets welcome</strong> in pet-friendly rooms; a small pet fee applies. See <a href="/pet-friendly-hotel-vernal-utah" style="color:var(--navy);font-weight:700;">pet friendly rooms</a>.</li>
</ul>
</div>

<div class="content-section">
 <h2>If You Are Staying Longer Than a Week</h2>
<p>Monthly rates exist but are not published on this site, and we would rather say so than print a number nobody at the desk has confirmed. If your stay runs past seven nights, call ${BUSINESS.phoneDisplay} and ask for the monthly rate directly — it is a different rate, not seven-night pricing repeated four times.</p>
<p>If you are weighing a long stay more generally, the <a href="/extended-stay-hotel-vernal-utah" style="color:var(--navy);font-weight:700;">extended stay page</a> covers what living here for weeks is actually like, and <a href="/workforce-housing-vernal-utah" style="color:var(--navy);font-weight:700;">workforce housing</a> covers crew bookings and company billing.</p>
</div>
<div class="content-section">
 <h2>What's Included at No Extra Cost</h2>
<p>Everything below is included in the weekly rate — there is no resort fee, no parking charge and no booking fee when you reserve direct.</p>
<ul class="feat-list">
 <li>Free hot breakfast daily — eggs, waffles, coffee, juice, pastries</li>
 <li>Free WiFi — fast enough for video calls and streaming</li>
 <li>Free parking — trucks, trailers, boats, work vehicles welcome</li>
 <li>Kitchenettes available — full fridge, microwave, stovetop</li>
 <li>On-site laundry facilities — no trips across town</li>
 <li>Pet friendly rooms — dogs welcome, small fee applies</li>
 <li>24-hour front desk — check in on shift worker schedules</li>
</ul>
</div>
<div class="pro-tip"><p><strong>Booking direct:</strong> call ${BUSINESS.phoneDisplay} and mention code <strong>${BUSINESS.directBooking.promoCode}</strong> for ${BUSINESS.directBooking.discountPercent}% off. Booking direct also means no booking fee, and the front desk can match you to the right room type — particularly for the suites, which have no published weekly rate. For company-paid stays, <a href="/corporate-rates" style="color:var(--navy);font-weight:600;text-decoration:none;border-bottom:1px solid rgba(var(--gold-rgb),0.5);">set up a corporate account</a> and billing is handled directly.</p></div>
<div class="content-section">
 <h2>Frequently Asked Questions</h2>
 <details style="border-bottom:1px solid #e8e4dc;padding:1rem 0;">
  <summary style="font-weight:700;color:var(--navy);cursor:pointer;font-size:1.02rem;">What are your weekly hotel rates?</summary>
  <p style="margin-top:.7rem;color:var(--muted);line-height:1.8;font-weight:300;">Weekly rates are quoted by the front desk rather than published — call ${BUSINESS.phoneDisplay} with your dates and room type for the current weekly price. Published nightly rates: Studio King ${usd(RATES.nightly.studioKing)}, Studio Two Queen ${usd(RATES.nightly.studioTwoQueen)}, Handicap / Accessible Studio King ${usd(RATES.nightly.accessibleStudioKing)}, Pet-Friendly Studio Two Queen ${usd(RATES.nightly.petFriendlyStudioTwoQueen)}, Pet-Friendly Room ${usd(RATES.nightly.petFriendlyRoom)}. All rates are ${RATES.taxNote} and include free breakfast, WiFi, parking and laundry access.</p>
 </details>
 <details style="border-bottom:1px solid #e8e4dc;padding:1rem 0;">
  <summary style="font-weight:700;color:var(--navy);cursor:pointer;font-size:1.02rem;">Do weekly rates include breakfast?</summary>
  <p style="margin-top:.7rem;color:var(--muted);line-height:1.8;font-weight:300;">Yes. Free hot breakfast every morning for every guest, regardless of stay length.</p>
 </details>
 <details style="border-bottom:1px solid #e8e4dc;padding:1rem 0;">
  <summary style="font-weight:700;color:var(--navy);cursor:pointer;font-size:1.02rem;">Are monthly rates available?</summary>
  <p style="margin-top:.7rem;color:var(--muted);line-height:1.8;font-weight:300;">Yes. Call (435) 789-6625 for monthly pricing. We work directly with guests on longer-term rates.</p>
 </details>
 <details style="border-bottom:1px solid #e8e4dc;padding:1rem 0;">
  <summary style="font-weight:700;color:var(--navy);cursor:pointer;font-size:1.02rem;">Can I get a kitchenette room for a weekly stay?</summary>
  <p style="margin-top:.7rem;color:var(--muted);line-height:1.8;font-weight:300;">Yes. Kitchenette rooms with a refrigerator, microwave, and stovetop are available. Specify when booking to guarantee availability.</p>
 </details>
</div>
<!-- ===== MESH: Plan Your Stay in Vernal — pillar+sibling cluster ===== -->
<section class="mesh-cluster" style="background:var(--cream);padding:3.5rem 1.5rem;border-top:1px solid rgba(var(--gold-rgb),0.25);border-bottom:1px solid rgba(var(--gold-rgb),0.25);margin:2rem 0 0;">
 <div style="max-width:1180px;margin:0 auto;">
  <p style="font-size:.95rem;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);text-align:center;margin:0 0 .4rem;font-weight:700;">✦ Plan Your Stay</p>
  <h2 style="font-family:'Playfair Display',serif;font-size:clamp(1.6rem,3.2vw,2.4rem);color:var(--navy);text-align:center;margin:0 0 .6rem;">Find the Right Room for Your Trip</h2>
  <p style="text-align:center;color:var(--muted);max-width:680px;margin:0 auto 2.4rem;font-size:1.02rem;">Whether you're staying a night or a month, exploring Dinosaur Country, or here for work — we have a page with the details you need. Start with our <a href="/" style="color:var(--navy);font-weight:700;border-bottom:1.5px solid var(--gold);text-decoration:none;">main hotel page</a> or jump straight to your situation:</p>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:2.2rem;">
    <div>
     <h3 style="font-family:'Playfair Display',serif;font-size:1.15rem;color:var(--navy);margin:0 0 .8rem;border-bottom:2px solid var(--gold);padding-bottom:.4rem;">By Stay Type</h3>
     <ul style="list-style:none;padding:0;margin:0;line-height:1.95;">
      <li><a href="/extended-stay-hotel-vernal-utah" style="color:var(--navy);font-weight:600;text-decoration:none;border-bottom:1px solid rgba(var(--gold-rgb),0.5);">Extended Stay</a> <span style="color:var(--muted);font-size:.88em;">— Weekly &amp; monthly stays, priced by phone</span></li>
      <li><a href="/weekly-hotel-rates-vernal-utah" style="color:var(--navy);font-weight:600;text-decoration:none;border-bottom:1px solid rgba(var(--gold-rgb),0.5);">Weekly Rates</a> <span style="color:var(--muted);font-size:.88em;">— 7-night discount pricing</span></li>
      <li><a href="/workforce-housing-vernal-utah" style="color:var(--navy);font-weight:600;text-decoration:none;border-bottom:1px solid rgba(var(--gold-rgb),0.5);">Workforce Housing</a> <span style="color:var(--muted);font-size:.88em;">— Crew lodging &amp; corporate billing</span></li>
      <li><a href="/oilfield-housing-vernal" style="color:var(--navy);font-weight:600;text-decoration:none;border-bottom:1px solid rgba(var(--gold-rgb),0.5);">Oilfield Housing</a> <span style="color:var(--muted);font-size:.88em;">— Truck parking, flexible billing</span></li>
      <li><a href="/pet-friendly-hotel-vernal-utah" style="color:var(--navy);font-weight:600;text-decoration:none;border-bottom:1px solid rgba(var(--gold-rgb),0.5);">Pet Friendly</a> <span style="color:var(--muted);font-size:.88em;">— Dogs welcome, ground-floor rooms</span></li>
      <li><a href="/dog-friendly-hotel-vernal" style="color:var(--navy);font-weight:600;text-decoration:none;border-bottom:1px solid rgba(var(--gold-rgb),0.5);">Dog Friendly</a> <span style="color:var(--muted);font-size:.88em;">— Hardwood floors, direct outdoor access</span></li>
      <li><a href="/cheap-hotel-vernal-utah" style="color:var(--navy);font-weight:600;text-decoration:none;border-bottom:1px solid rgba(var(--gold-rgb),0.5);">Affordable Rooms</a> <span style="color:var(--muted);font-size:.88em;">— Best value in Vernal, no hidden fees</span></li>
      <li><a href="/best-hotel-in-vernal-utah" style="color:var(--navy);font-weight:600;text-decoration:none;border-bottom:1px solid rgba(var(--gold-rgb),0.5);">Compare Vernal Hotels</a> <span style="color:var(--muted);font-size:.88em;">— How we compare on value</span></li>
     </ul>
    </div>
    <div>
     <h3 style="font-family:'Playfair Display',serif;font-size:1.15rem;color:var(--navy);margin:0 0 .8rem;border-bottom:2px solid var(--gold);padding-bottom:.4rem;">By Destination</h3>
     <ul style="list-style:none;padding:0;margin:0;line-height:1.95;">
      <li><a href="/hotel-near-vernal-airport" style="color:var(--navy);font-weight:600;text-decoration:none;border-bottom:1px solid rgba(var(--gold-rgb),0.5);">Near Vernal Airport</a> <span style="color:var(--muted);font-size:.88em;">— 0.6 miles</span></li>
      <li><a href="/hotel-near-dinosaur-national-monument" style="color:var(--navy);font-weight:600;text-decoration:none;border-bottom:1px solid rgba(var(--gold-rgb),0.5);">Near Dinosaur Nat'l Monument</a> <span style="color:var(--muted);font-size:.88em;">— 20 miles</span></li>
      <li><a href="/hotel-near-flaming-gorge" style="color:var(--navy);font-weight:600;text-decoration:none;border-bottom:1px solid rgba(var(--gold-rgb),0.5);">Near Flaming Gorge</a> <span style="color:var(--muted);font-size:.88em;">— 40 miles</span></li>
      <li><a href="/hotel-near-red-fleet-state-park" style="color:var(--navy);font-weight:600;text-decoration:none;border-bottom:1px solid rgba(var(--gold-rgb),0.5);">Near Red Fleet State Park</a> <span style="color:var(--muted);font-size:.88em;">— 12 miles</span></li>
      <li><a href="/hotel-near-ashley-national-forest" style="color:var(--navy);font-weight:600;text-decoration:none;border-bottom:1px solid rgba(var(--gold-rgb),0.5);">Near Ashley National Forest</a> <span style="color:var(--muted);font-size:.88em;">— 15 miles</span></li>
      <li><a href="/hotel-near-jensen-utah" style="color:var(--navy);font-weight:600;text-decoration:none;border-bottom:1px solid rgba(var(--gold-rgb),0.5);">Near Jensen, Utah</a> <span style="color:var(--muted);font-size:.88em;">— 10 miles</span></li>
      <li><a href="/naples-utah-hotel" style="color:var(--navy);font-weight:600;text-decoration:none;border-bottom:1px solid rgba(var(--gold-rgb),0.5);">Near Naples, Utah</a> <span style="color:var(--muted);font-size:.88em;">— Minutes away — no hotel in Naples itself</span></li>
     </ul>
    </div>
    <div>
     <h3 style="font-family:'Playfair Display',serif;font-size:1.15rem;color:var(--navy);margin:0 0 .8rem;border-bottom:2px solid var(--gold);padding-bottom:.4rem;">Plan Your Visit</h3>
     <ul style="list-style:none;padding:0;margin:0;line-height:1.95;">
      <li><a href="/vernal-utah-travel-guide" style="color:var(--navy);font-weight:600;text-decoration:none;border-bottom:1px solid rgba(var(--gold-rgb),0.5);">Vernal Travel Guide</a> <span style="color:var(--muted);font-size:.88em;">— Plan your trip</span></li>
      <li><a href="/things-to-do-vernal-utah" style="color:var(--navy);font-weight:600;text-decoration:none;border-bottom:1px solid rgba(var(--gold-rgb),0.5);">Things to Do</a> <span style="color:var(--muted);font-size:.88em;">— Activities &amp; attractions</span></li>
      <li><a href="/explore" style="color:var(--navy);font-weight:600;text-decoration:none;border-bottom:1px solid rgba(var(--gold-rgb),0.5);">Explore Vernal</a> <span style="color:var(--muted);font-size:.88em;">— Restaurants &amp; adventures</span></li>
      <li><a href="/faq" style="color:var(--navy);font-weight:600;text-decoration:none;border-bottom:1px solid rgba(var(--gold-rgb),0.5);">FAQ</a> <span style="color:var(--muted);font-size:.88em;">— Common questions</span></li>
     </ul>
    </div>
  </div>
  <div style="text-align:center;margin-top:2.6rem;">
   <a href="/" style="display:inline-block;background:var(--gold);color:var(--navy);font-weight:700;padding:.85rem 1.8rem;border-radius:4px;text-decoration:none;letter-spacing:.04em;">← Back to Best Western Vernal Inn</a>
  </div>
 </div>
</section>
<!-- ===== /MESH ===== -->
</div>
<div class="cta-contact">
 <h2>Ready to Book?</h2>
 <p>${WEEKLY_CALL_LINE} · Free hot breakfast · Free parking · Pet friendly</p>
 <div class="contact-options">
  <a href="tel:${BUSINESS.phoneTel}" class="contact-opt">
   <span class="icon">📞</span>
   <span class="lbl">Call Directly</span>
   <span class="val">${BUSINESS.phoneDisplay}</span>
  </a>
  <a href="mailto:surestayplus53027@gmail.com" class="contact-opt">
   <span class="icon">✉️</span>
   <span class="lbl">Email</span>
   <span class="val">Send a Message</span>
  </a>
  <a href="tel:${BUSINESS.phoneTel}" class="contact-opt book">
   <span class="icon">📞</span>
   <span class="lbl">${BUSINESS.directBooking.ctaLabel} ${BUSINESS.directBooking.discountPercent}%</span>
   <span class="val">Mention code ${BUSINESS.directBooking.promoCode}</span>
  </a>
 </div>
</div>`;
---

<BaseLayout
  title=`Weekly Hotel Rates in Vernal, Utah | Best Western Vernal Inn — Call for Weekly Price`
  description=`Weekly hotel rates at Best Western Vernal Inn are quoted by phone — call (435) 789-6625 for your dates. Nightly rates from ${LOWEST_NIGHTLY} + tax. Free breakfast, kitchenettes, pet friendly.`
  canonical=`https://bestwesternvernalinn.com/weekly-hotel-rates-vernal-utah`
  ogTitle=`Weekly Hotel Rates in Vernal, Utah | Best Western Vernal Inn — Call for Weekly Price`
  ogDescription=`Weekly hotel rates at Best Western Vernal Inn are quoted by phone — call (435) 789-6625 for your dates. Nightly rates from ${LOWEST_NIGHTLY} + tax. Free breakfast, kitchenettes, pet friendly.`
  ogImage=`https://bestwesternvernalinn.com/images/35.webp`
  twitterTitle=`Weekly Hotel Rates in Vernal, Utah | Best Western Vernal Inn — Call for Weekly Price`
  twitterDescription=`Weekly hotel rates at Best Western Vernal Inn are quoted by phone — call (435) 789-6625 for your dates. Nightly rates from ${LOWEST_NIGHTLY} + tax. Free breakfast, kitchenettes, pet friendly.`
