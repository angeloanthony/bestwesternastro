---
// src/pages/rooms/[slug].astro
//
// ONE template, five pages. Every room fact — name, price, photographs,
// captions, features, copy and SEO metadata — comes from src/data/rooms.ts.
// Nothing about any individual room is written here, so this file never has to
// change when a rate moves or a photograph is added.
//
// URLs: astro.config.mjs sets build.format:'file', so this emits
// dist/rooms/<slug>.html and the page is served at /rooms/<slug> — the same
// extensionless shape every other page on the site uses.

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTA from '../../components/CTA.astro';
import { BUSINESS } from '../../data/business.ts';
import { RATES, WEEKLY_CALL_PHRASE } from '../../data/rates.ts';
import { hotelNode, hotelRef, ldScript } from '../../data/schema.ts';
import { ROOMS, otherRooms, roomHref, roomUrl, type Room } from '../../data/rooms.ts';
import '../../styles/rooms.css';

export function getStaticPaths() {
  return ROOMS.map((room) => ({ params: { slug: room.slug }, props: { room } }));
}

interface Props {
  room: Room;
}
const { room } = Astro.props;

const canonical = roomUrl(room.slug);

// Hero slideshow. The wide, room-level frames flagged `heroSlide` in rooms.ts,
// falling back to the single lead image where a room has none of them.
const heroSlides = room.gallery.filter((p) => p.heroSlide);
if (heroSlides.length === 0) heroSlides.push(room.hero);

/** Milliseconds a hero slide holds before the next one crosses in.
 *  Deliberately brisker than the homepage reel's 6000ms — a room page has one
 *  room to show and a guest scrolls past the hero quickly. 3200 -> 2200 -> 1500:
 *  the photograph is now the whole top of the page rather than a backdrop
 *  behind a panel, so the reel is the room tour and it should move like one.
 *  At 1500 with the 350ms cross-fade in rooms.css the seven-slide pet-friendly
 *  hero completes a full pass in about 10.5s instead of 15s.
 *  Change this and the `.rm-hero-img` transition together — they are one
 *  effect split across two files. */
const HERO_MS = 1500;

const abs = (src: string) => `${BUSINESS.site.domain}/${src}`;
const tel = `tel:${BUSINESS.phoneTel}`;
const bookLabel = `${BUSINESS.directBooking.ctaLabel} ${BUSINESS.directBooking.discountPercent}%`;
const others = otherRooms(room.slug);

// ── Structured data ─────────────────────────────────────────────────────────
// A HotelRoom node with ONE nightly Offer. There is deliberately no weekly
// Offer of any kind: RATES.weekly is null across the board and the site's
// answer for a weekly stay is "call for price" (rates.ts). An Offer is a
// machine-readable price promise, so an invented one is worse here than
// anywhere else on the page.
const roomNode = {
  '@context': 'https://schema.org',
  '@type': 'HotelRoom',
  '@id': `${canonical}#room`,
  name: room.name,
  description: room.about[0],
  url: canonical,
  image: [room.hero, ...room.gallery].map((p) => abs(p.src)),
  containedInPlace: hotelRef(),
  ...(room.seo.bedType
    ? { bed: { '@type': 'BedDetails', typeOfBed: room.seo.bedType } }
    : {}),
  ...(room.seo.occupancy
    ? {
        occupancy: {
          '@type': 'QuantitativeValue',
          maxValue: room.seo.occupancy,
          unitCode: 'C62',
        },
      }
    : {}),
  amenityFeature: room.features.map((f) => ({
    '@type': 'LocationFeatureSpecification',
    name: f.label,
    value: true,
  })),
  ...(room.nightly.published
    ? {
        offers: {
          '@type': 'Offer',
          name: `${room.name} — nightly rate`,
          priceCurrency: RATES.currency,
          price: room.nightly.price.replace('$', ''),
          priceSpecification: {
            '@type': 'UnitPriceSpecification',
            priceCurrency: RATES.currency,
            price: room.nightly.price.replace('$', ''),
            unitCode: 'DAY',
            valueAddedTaxIncluded: false,
          },
          availability: 'https://schema.org/InStock',
          url: canonical,
        },
      }
    : {}),
};
---

<BaseLayout
  title={room.seo.title}
  description={room.seo.description}
  canonical={canonical}
  ogType="product"
  ogImage={abs(room.hero.src)}
  twitterImage={abs(room.hero.src)}
  lastUpdated="September 2026"
>
  <Fragment slot="schema">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(hotelNode())} />
    <Fragment set:html={ldScript(roomNode)} />
    <Breadcrumbs
      items={[
        { name: 'Home', url: BUSINESS.site.canonicalHome },
        { name: room.name, url: canonical },
      ]}
    />
  </Fragment>

  <!-- ═══ 1. ROOM HERO ═══════════════════════════════════════════════════ -->
  <!-- The backdrop is a slideshow of this room's wide, room-level frames (the
       `heroSlide` photos in rooms.ts), so the top of the page shows the space
       from several angles rather than one. Only the first slide's image is set
       in the markup; the rest carry `data-bg` and are promoted to real
       background-images after load, so the hero paints on one download instead
       of seven. A room with no photographs (the $135 Pet-Friendly Room) falls
       back to a single still — there is nothing to cycle.
       The image is carried as two custom properties rather than a
       background-image so rooms.css can pick the frame's 9:16 `portrait` twin
       on a tall phone viewport with no script and no second download. -->
  <section class="rm-hero">
    <div class="rm-hero-stage" id="rm-hero-stage" data-ms={HERO_MS}>
      {heroSlides.map((p, i) => (
        <div
          class:list={['rm-hero-img', { 'is-on': i === 0 }]}
          style={
            i === 0
              ? `--rm-bg:url('/${p.src}')${p.portrait ? `;--rm-bg-p:url('/${p.portrait}')` : ''}`
              : undefined
          }
          data-bg={i === 0 ? undefined : `/${p.src}`}
          data-bg-portrait={i === 0 || !p.portrait ? undefined : `/${p.portrait}`}
          role="img"
          aria-label={p.alt}
          aria-hidden={i === 0 ? undefined : 'true'}
        ></div>
      ))}
    </div>
    <div class="rm-hero-ov"></div>
    {/* The label band, underneath the photograph rather than over it. Two
        groups so it can be one row on a wide screen and a stack on a phone:
        --lede is what the room IS, --act is what you do about it. */}
    <div class="rm-hero-cnt">
      <div class="rm-hero-lede">
        <p class="rm-eyebrow">{room.eyebrow}</p>
        <h1>{room.name}</h1>

        <p class="rm-price">
          <span class="rm-price-amt">{room.nightly.price}</span>
          {room.nightly.published && <span class="rm-price-per">/ night</span>}
          <span class="rm-price-tax">{room.nightly.note}</span>
        </p>
        {/* --fee is the room's own fine print (pet fee, deposit). It repeats in
            full in the pricing band below, so the phone hero drops it. */}
        {room.footnote && <p class="rm-foot rm-foot--fee">{room.footnote}</p>}
        {/* Label the picture where it is not a photograph of this room type.
            --cap is a disclosure about the photograph on screen and is repeated
            nowhere else, so it stays at every width. */}
        {room.gallery.length === 0 && <p class="rm-foot rm-foot--cap">{room.hero.caption}</p>}
      </div>

      <div class="rm-hero-act">
        <p class="rm-weekly">{room.weekly}</p>
        <div class="rm-btns">
          <a href={tel} class="rm-btn rm-btn-p" data-track="phone_call_room_hero">
            Book Now · {BUSINESS.phoneDisplay}
          </a>
          <a href="#rm-pricing" class="rm-btn rm-btn-s">Check Availability</a>
        </div>
      </div>

      {heroSlides.length > 1 && (
        <div class="rm-hero-dots" id="rm-hero-dots" role="tablist" aria-label={`${room.name} photographs`}>
          {heroSlides.map((p, i) => (
            <button
              type="button"
              role="tab"
              class:list={['rm-hero-dot', { 'is-on': i === 0 }]}
              data-i={i}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-label={`View ${i + 1} of ${heroSlides.length}: ${p.alt}`}
            ></button>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- ═══ 2. PHOTO GALLERY ═══════════════════════════════════════════════ -->
  <section class="rm-sec" id="rm-gallery">
    <h2>Take a Look Inside</h2>
    {room.gallery.length > 0 ? (
      <Fragment>
        <p class="rm-sec-note">
          {room.gallery.length} photographs of the {room.name}. Tap any one to
          enlarge it and step through the rest.
        </p>
        <div class="rm-grid">
          {room.gallery.map((p, i) => (
            <button
              type="button"
              class="rm-tile"
              data-rm-i={i}
              data-rm-src={`/${p.src}`}
              data-rm-cap={p.caption}
              aria-label={`Enlarge photograph ${i + 1} of ${room.gallery.length}: ${p.caption}`}
            >
              <img src={`/${p.src}`} alt={p.alt} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
              <span class="rm-tile-cap">{p.caption}</span>
            </button>
          ))}
        </div>
      </Fragment>
    ) : (
      <div class="rm-notice">
        <p>{room.galleryNotice}</p>
      </div>
    )}
  </section>

  <!-- ═══ 3. ABOUT THIS ROOM ═════════════════════════════════════════════ -->
  <section class="rm-sec">
    <h2>About This Room</h2>
    {room.about.map((para) => <p>{para}</p>)}
    <div class="rm-diff">
      <p><strong>What makes it different:</strong> {room.difference}</p>
    </div>
  </section>

  <!-- ═══ 4. ROOM FEATURES ═══════════════════════════════════════════════ -->
  <section class="rm-sec">
    <h2>Room Features</h2>
    <p class="rm-sec-note">
      Everything listed here is either visible in the photographs above or
      already published by the hotel. If something is not on this list, it is
      because we have not confirmed it — call the front desk and ask rather than
      assume.
    </p>
    <ul class="rm-feats">
      {room.features.map((f) => <li>{f.label}</li>)}
    </ul>
  </section>

  <!-- ═══ 5. PRICING ═════════════════════════════════════════════════════ -->
  <div class="rm-pricing" id="rm-pricing">
    <section class="rm-sec">
      <h2>Rates for the {room.name}</h2>
      <div class="rm-rate-card">
        <div>
          <p class="rm-rate-lbl">Nightly</p>
          <p class="rm-price">
            <span class="rm-price-amt">{room.nightly.price}</span>
            {room.nightly.published && <span class="rm-price-per">/ night</span>}
          </p>
          <p class="rm-price-tax">{room.nightly.note}</p>
        </div>
        <div>
          <p class="rm-rate-lbl">Weekly</p>
          <p class="rm-weekly">{room.weekly}</p>
        </div>
      </div>
      <p>
        {room.nightly.price} is the hotel's confirmed nightly rate for the {room.name} — not a
        starting price and not an average. It is quoted before tax, and tax is added at check-in.
      </p>
      <p>
        Staying a week or longer? We publish no weekly figure for any room type — the answer is
        {' '}{WEEKLY_CALL_PHRASE}. Call
        <a href={tel} style="color:var(--gold);font-weight:700;"> {BUSINESS.phoneDisplay}</a> and
        ask the front desk for a weekly quote on this room.
      </p>
      {room.footnote && <p>{room.footnote}. Up to two dogs per room, 80 lb limit per dog.</p>}
    </section>
  </div>

  <!-- ═══ 6. BOOKING CTA ═════════════════════════════════════════════════ -->
  <section class="rm-sec">
    <h2>Ready to Book This Room?</h2>
    <p>
      Book direct and mention code {BUSINESS.directBooking.promoCode} to save
      {' '}{BUSINESS.directBooking.discountPercent}%. The front desk is staffed 24 hours, so a late call is fine.
      For a stay of a week or more, ask for the weekly rate on the {room.name} while you have them
      on the phone — weekly stays are quoted by phone and never published on this site.
    </p>
  </section>

  {/* The site-wide booking block carries the actual buttons — call, email and
      the promo code. It is given the room's own heading so the page does not
      say "Ready to Book" twice in a row. */}
  <CTA
    heading={`${room.name} · ${room.nightly.price}${room.nightly.published ? ' / night' : ''} ${RATES.taxNote}`}
    tagline={`${bookLabel} — mention code ${BUSINESS.directBooking.promoCode} · ${room.weekly} · Free hot breakfast · Free WiFi · Free parking`}
  />

  <!-- ═══ 7. RELATED ROOMS ═══════════════════════════════════════════════ -->
  <div class="rm-related">
    <section class="rm-sec">
      <h2>Looking for a Different Room?</h2>
      <p class="rm-sec-note">
        Every room type on the hotel's rate card, with its confirmed nightly rate.
      </p>
      <div class="rm-cards">
        {others.map((r) => (
          <a class="rm-card" href={roomHref(r.slug)}>
            <img src={`/${r.hero.src}`} alt={r.hero.alt} loading="lazy" decoding="async" />
            <div class="rm-card-b">
              <p class="rm-card-n">{r.name}</p>
              <p class="rm-card-p">
                <strong>{r.nightly.price}</strong>{r.nightly.published ? ' / night' : ''} {RATES.taxNote}
                {r.sleeps ? ` · ${r.sleeps}` : ''}
              </p>
            </div>
          </a>
        ))}
      </div>
      <p style="margin-top:1.6rem;">
        <a href="/" style="color:var(--navy);font-weight:700;">← Back to Best Western Vernal Inn</a>
      </p>
    </section>
  </div>

  <!-- Lightbox. Rendered only when there are photographs to open. -->
  {room.gallery.length > 0 && (
    <div class="rm-lb" id="rm-lb" role="dialog" aria-modal="true" aria-label="Room photographs">
      <button type="button" class="rm-lb-x" id="rm-lb-x" aria-label="Close">×</button>
      <button type="button" class="rm-lb-prev" id="rm-lb-prev" aria-label="Previous photograph">‹</button>
      <button type="button" class="rm-lb-next" id="rm-lb-next" aria-label="Next photograph">›</button>
      <div class="rm-lb-stage"><img id="rm-lb-img" src="" alt="" /></div>
      <p class="rm-lb-cap">
        <span class="rm-lb-count" id="rm-lb-count"></span>
        <span id="rm-lb-text"></span>
      </p>
    </div>
  )}

  <script slot="scripts" is:inline>
    // Hero slideshow. Cross-fades the room's wide frames behind the price card.
    // Pauses while the tab is hidden, while a pointer is over the hero, and for
    // anyone who has asked their system for reduced motion — in that last case
    // the first frame simply stays put.
    (function () {
      var stage = document.getElementById('rm-hero-stage');
      if (!stage) return;
      var slides = stage.querySelectorAll('.rm-hero-img');
      if (slides.length < 2) return;

      var dots = document.querySelectorAll('.rm-hero-dot');
      var ms = parseInt(stage.getAttribute('data-ms'), 10) || 3200;
      var i = 0;
      var timer = null;

      // Promote the deferred backgrounds once the page has settled, so the
      // first paint only ever pays for slide one.
      function hydrate() {
        for (var n = 0; n < slides.length; n++) {
          var bg = slides[n].getAttribute('data-bg');
          if (bg) {
            slides[n].style.setProperty('--rm-bg', "url('" + bg + "')");
            slides[n].removeAttribute('data-bg');
          }
          var bgp = slides[n].getAttribute('data-bg-portrait');
          if (bgp) {
            slides[n].style.setProperty('--rm-bg-p', "url('" + bgp + "')");
            slides[n].removeAttribute('data-bg-portrait');
          }
        }
      }
      if (document.readyState === 'complete') hydrate();
      else window.addEventListener('load', hydrate);

      function show(n) {
        slides[i].classList.remove('is-on');
        slides[i].setAttribute('aria-hidden', 'true');
        if (dots[i]) {
          dots[i].classList.remove('is-on');
          dots[i].setAttribute('aria-selected', 'false');
        }
        i = (n + slides.length) % slides.length;
        slides[i].classList.add('is-on');
        slides[i].removeAttribute('aria-hidden');
        if (dots[i]) {
          dots[i].classList.add('is-on');
          dots[i].setAttribute('aria-selected', 'true');
        }
      }

      var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      function start() {
        if (!timer && !still && !document.hidden) timer = setInterval(function () { show(i + 1); }, ms);
      }
      function stop() {
        if (timer) { clearInterval(timer); timer = null; }
      }

      for (var d = 0; d < dots.length; d++) {
        dots[d].addEventListener('click', function () {
          show(parseInt(this.getAttribute('data-i'), 10));
          stop();
          start();
        });
      }

      stage.parentNode.addEventListener('mouseenter', stop);
      stage.parentNode.addEventListener('mouseleave', start);
      document.addEventListener('visibilitychange', function () {
        if (document.hidden) stop();
        else start();
      });
      start();
    })();

    // Gallery lightbox. No framework, no dependencies — it reads the tile
    // buttons the page already rendered, so the markup stays the single source
    // of what is in the gallery. Keyboard: ← → to move, Esc to close.
    (function () {
      var lb = document.getElementById('rm-lb');
      if (!lb) return;
      var tiles = Array.prototype.slice.call(document.querySelectorAll('.rm-tile'));
      var img = document.getElementById('rm-lb-img');
      var text = document.getElementById('rm-lb-text');
      var count = document.getElementById('rm-lb-count');
      var i = 0;
      var opener = null;

      function show(n) {
        i = (n + tiles.length) % tiles.length;
        var t = tiles[i];
        img.src = t.getAttribute('data-rm-src');
        img.alt = t.querySelector('img').alt;
        text.textContent = t.getAttribute('data-rm-cap');
        count.textContent = i + 1 + ' of ' + tiles.length;
      }
      function open(n) {
        opener = tiles[n];
        show(n);
        lb.classList.add('open');
        document.body.style.overflow = 'hidden';
        document.getElementById('rm-lb-x').focus();
      }
      function close() {
        lb.classList.remove('open');
        document.body.style.overflow = '';
        if (opener) opener.focus();
      }

      tiles.forEach(function (t, n) {
        t.addEventListener('click', function () {
          open(n);
        });
      });
      document.getElementById('rm-lb-x').addEventListener('click', close);
      document.getElementById('rm-lb-prev').addEventListener('click', function () {
        show(i - 1);
      });
      document.getElementById('rm-lb-next').addEventListener('click', function () {
        show(i + 1);
      });
      // Click the backdrop (not a control or the photo itself) to dismiss.
      lb.addEventListener('click', function (e) {
        if (e.target === lb || e.target.classList.contains('rm-lb-stage')) close();
      });
      document.addEventListener('keydown', function (e) {
        if (!lb.classList.contains('open')) return;
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowLeft') show(i - 1);
        else if (e.key === 'ArrowRight') show(i + 1);
      });

      // Swipe between photographs on a phone.
      var x0 = null;
      lb.addEventListener('touchstart', function (e) {
        x0 = e.changedTouches[0].clientX;
      }, { passive: true });
      lb.addEventListener('touchend', function (e) {
        if (x0 === null) return;
        var dx = e.changedTouches[0].clientX - x0;
        if (Math.abs(dx) > 45) show(dx < 0 ? i + 1 : i - 1);
        x0 = null;
      }, { passive: true });
    })();
  </script>
</BaseLayout>
