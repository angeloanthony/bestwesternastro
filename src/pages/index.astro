 <a href="tel:${BUSINESS.phoneTel}" class="btn-p" data-track="phone_call_homepage">📞 ${BUSINESS.directBooking.ctaLabel} ${BUSINESS.directBooking.discountPercent}%</a>
 <a href="#rooms" class="btn-s">Explore Rooms</a>
 </div>
