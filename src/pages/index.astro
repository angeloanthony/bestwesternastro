 }
 </script>
<style>
 /* Page Summary Bar */
 .page-summary-bar {
 position: absolute;
 width: 1px;
 height: 1px;
 padding: 0;
 margin: -1px;
 overflow: hidden;
 clip: rect(0,0,0,0);
 white-space: nowrap;
 border: 0;
 }

 /* Badge styles moved to styles.css */
 </style>`;
const bodyContent = `<!-- ═══════════════════════════════════════════════════════════
     EXECUTIVE INN FLOATING BADGE — LEFT SIDE
     Remove this entire block once Best Western branding is official
     ═══════════════════════════════════════════════════════════ -->
