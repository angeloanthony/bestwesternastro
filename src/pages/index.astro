---
// src/pages/index.astro
// MIGRATION of /index.html — metadata, canonical, JSON-LD schema, body copy,
// headings, and internal links preserved VERBATIM. Shared chrome
// (nav / mobile menu / footer / scroll-top + burger script) is provided by
// BaseLayout; page-specific <style>/schema go in the head slot and
// page-specific scripts in the scripts slot, both emitted unchanged.
import BaseLayout from '../layouts/BaseLayout.astro';
import { hotelNodeFull, hotelRef, ldScript } from '../data/schema.ts';
import { RATES, usd, LOWEST_NIGHTLY, WEEKLY_CALL_LINE } from '../data/rates.ts';
import { BUSINESS } from '../data/business.ts';
import { HERO_SLIDES } from '../data/heroShowcase.ts';
// The gallery grid AND its lightbox both render from this one array. They used
// to be two hand-kept lists linked by index, and the indices no longer agreed —
// every room tile opened a different photograph. See the note in the file.
import { HOME_GALLERY } from '../data/homeGallery.ts';
// Detailed room pages (/rooms/*). Slugs live in rooms.ts, so the links below
// and the pages themselves can never drift apart.
import { roomBySlideId, roomHref, ROOMS } from '../data/rooms.ts';
// The "Every Room Feels Like Home" tabs. This section used to be ~320 lines of
// hand-written markup showing CGI renders of rooms the hotel does not sell —
// see the header of the file for what had gone wrong with it.
import { ROOM_TABS } from '../data/homeRoomTabs.ts';

/** Root-relative link to a room's detail page, by its hero-reel slide id. */
const slideRoomHref = (slideId: string): string | null => {
  const r = roomBySlideId(slideId);
  return r ? roomHref(r.slug) : null;
};
/** Root-relative link to a room's detail page, by its rate-card name. */
const nameRoomHref = (name: string): string | null => {
  const r = ROOMS.find((x) => x.name === name);
  return r ? roomHref(r.slug) : null;
};
/** Rate-table room-name cell: a link where a detail page exists, plain text
 *  otherwise (the suites have no confirmed rate and so no page). */
const rateCell = (name: string): string => {
  const href = nameRoomHref(name);
  return href
    ? `<a href="${href}" style="color:var(--navy);font-weight:700;text-decoration:none;border-bottom:1px solid rgba(var(--gold-rgb),.65);">${name}</a>`
    : `<strong>${name}</strong>`;
};

/* ── Escaping, for the room-tab copy in src/data/homeRoomTabs.ts ───────────────
 * That file holds prose, not markup: a pill reads "Fridge & Freezer" and a
 * caption may contain an apostrophe. Three small helpers put it into HTML.   */

/** Bare "&" → "&amp;", leaving existing entities and the `<br>`/`<em>` in the
 *  headlines alone. */
const amp = (s: string): string => s.replace(/&(?![a-zA-Z#][a-zA-Z0-9]*;)/g, '&amp;');
/** For an attribute value delimited by double quotes. */
const attr = (s: string): string => amp(s).replace(/"/g, '&quot;');
/** For a single-quoted JS string argument inside a double-quoted onclick — the
 *  lightbox captions are full sentences and several contain an apostrophe. */
const jsArg = (s: string): string =>
  attr(s.replace(/\\/g, '\\\\').replace(/'/g, "\\'"));

const hotelDescription = `Newly transformed Best Western Inn in Vernal, Utah. Nightly rates from ${LOWEST_NIGHTLY} + tax; weekly rates available — call for price. Free hot breakfast daily, full kitchenettes, jacuzzi suites, pet friendly rooms, and heated floors in the dining room.`;

const headExtras = `<!-- The reel's opening photograph is the largest thing above the fold and was
     queueing behind 28 other images; measured on an 8 Mbps connection it did not
     paint for 3.5s, so the hero sat blank while the reel counted down. -->
<link rel="preload" as="image" href="${HERO_SLIDES[0].image}" media="(min-aspect-ratio: 3/4)" fetchpriority="high">${HERO_SLIDES[0].portrait ? `
<link rel="preload" as="image" href="${HERO_SLIDES[0].portrait}" media="(max-aspect-ratio: 3/4)" fetchpriority="high">
<style>@media (max-aspect-ratio: 3/4){#hero .hero-slide:first-of-type .hero-kb{background-image:url('${HERO_SLIDES[0].portrait}')!important}}</style>` : ''}
${ldScript(hotelNodeFull(hotelDescription))}
<script type="application/ld+json">
 {
