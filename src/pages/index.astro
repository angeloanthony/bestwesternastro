  <button id="ei-badge-close"
    onclick="document.getElementById('ei-badge').style.display='none';"
    aria-label="Dismiss notice">✕</button>
  <div class="ei-header">
    <span class="ei-dot"></span> We're Open!
  </div>
  <div class="ei-body">
        This page previews the <em>exciting upgrades</em> coming as we transform into <strong>Best Western Vernal Inn</strong>.<br><br>  Not yet listed on BestWestern.com — book directly and save ${BUSINESS.directBooking.discountPercent}% with discount code <strong>${BUSINESS.directBooking.promoCode}</strong>: <a href="tel:${BUSINESS.phoneTel}" style="color:var(--gold);font-size:1.1rem;font-weight:900;letter-spacing:1px;">📞 ${BUSINESS.phoneDisplay}</a>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════ -->

<!-- PAGE SUMMARY BAR — AI-extractable content, visible to all crawlers -->
<div class="page-summary-bar" role="complementary" aria-label="Quick summary">
 <strong>Best Western Vernal Inn</strong> — Extended stay hotel in Vernal, Utah. Nightly rates from ${LOWEST_NIGHTLY} + tax (Studio King). Weekly rates — call for price. Free hot breakfast daily, full kitchenettes, jacuzzi suites, pet friendly rooms, free WiFi and free parking. Located at 1935 South 1500 East, Vernal, UT 84078 — 0.6 miles from Vernal Regional Airport, near Dinosaur National Monument. Call <strong>(435) 789-6625</strong> and mention code ROCCO to save 10%.
</div>

<!-- NAV -->


<!-- HERO SLIDESHOW — cinematic Ken Burns backgrounds.
     Opens on the two property shots, then walks one room type per slide with
     its rate laid over the photograph. Slides and rates both come from
     src/data/heroShowcase.ts → src/data/rates.ts; nothing is hardcoded here. -->
<section class="hero" id="hero" aria-roledescription="carousel" aria-label="Best Western Vernal Inn — rooms and rates">
${HERO_SLIDES.map((s, i) => `<div class="hero-slide ${s.kb}${i === 0 ? ' active' : ''}" role="img" aria-label="${s.alt}"><div class="hero-kb"${i === 0 ? ` style="background-image:url('${s.image}')"` : ` data-bg="${s.image}"`}${s.portrait ? ` data-bg-portrait="${s.portrait}"` : ''}></div></div>`).join('\n')}
 <div class="hero-ov"></div>
 <div class="hero-cnt">
 <p class="eyebrow">Coming Soon in Vernal, Utah as</p>
 <h1 class="htitle">Best Western Inn<br><em>Vernal, Utah</em></h1>
 <p class="hsub">The Executive Inn is in the process of being beautifully transformed into Best Western Vernal Inn — spacious rooms, free hot breakfast, and a warm welcome every single day. Your home away from home.</p>
