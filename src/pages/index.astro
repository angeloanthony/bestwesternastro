// Hero Slideshow — Ken Burns backgrounds
/* ── Hero room reel ──
   Two property shots then one slide per room type. The rate card layer is a
   separate stack of <article>s keyed by data-slide, so the price cross-fades in
   step with the photo without being re-rendered. Autoplay pauses on hover, on
   focus, and while the tab is hidden. */
const slides  = document.querySelectorAll('.hero-slide');
const dc      = document.getElementById('hdots');
const rooms   = document.querySelectorAll('.hroom');
const heroEl  = document.getElementById('hero');
const hlabels = ${JSON.stringify(HERO_SLIDES.map((s) => s.label))};
const hstill  = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const hfirst  = ${JSON.stringify(HERO_SLIDES[0].image)};
/* A phone hero is a 100vh box at about 0.46:1 and cover-cropping a landscape
   photograph into it keeps only ~a third of its width, so below 3:4 the reel
   serves 9:16 versions instead. Slide 0 is switched by the <style> in the head
   rather than here, so it needs no JavaScript to paint the right one. */
const hportrait = window.matchMedia('(max-aspect-ratio: 3/4)');
/* The scale a slide starts its Ken Burns from. Below 3:4 the stage is sized to
   the 9:16 frames themselves (global.css), so the photograph fits it exactly
   and ANY scale above 1 is the side-crop coming straight back — 8% of it, on a
   frame that was chosen for this shape. Read at slide time, not once at load,
   so a rotation mid-reel gets the right one. */
const hkbFrom = () => (hportrait.matches ? 1 : 1.08);
/* Milliseconds a hero slide holds. 6000 -> 4200 -> 3000: this reel opens on two
   property shots before it reaches a single room, so at 6s a guest waited 12s
   to see the first rate and now waits 6s. Still twice the room pages' 1500ms on
   purpose — a slide here carries a rate card to read, not just a photograph,
   and 3000 is about the floor for that: below it the price stops being
   readable before it is replaced.
   Three things are paired to it and must move with it: the .hero-slide and
   .hroom cross-fades in global.css, and HOME_KB_MS just below. */
const HOME_HERO_MS = 3000;
/* The Ken Burns drift is deliberately longer than the hold — it is a slow
   push that gets interrupted by the next slide, never a move that finishes.
   Scaled with the hold (8000 x 3000/6000) so each slide still shows the same
   share of the drift as it did at 6s rather than visibly less of it. */
const HOME_KB_MS = 4000;
let cs = 0;
let htimer = null;

if (slides.length && dc) {
