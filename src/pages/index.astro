 <div style="font-size:.7rem;opacity:.85;">Use this code when you call to save ${BUSINESS.directBooking.discountPercent}%.</div>
 </div>
 </div>

 <!-- ROOM RATE RIBBON — one panel per room slide, cross-faded in step with the
      photo. It sits at the foot of the hero column rather than floating in a
      corner: #ei-badge is position:fixed over the left edge and .pet-badge over
      the right, and between them a corner card is unreadable on any laptop-height
      screen. Three blocks on desktop, stacked on phones. -->
 <div class="hroom-layer" id="hroom-layer">
${HERO_SLIDES.map((s, i) => {
  if (!s.room) return '';
  const r = s.room;
  // Link the slide to its detailed room page. Inline-styled rather than given a
  // new global class: the brief is to link the existing reel, not restyle it.
  const href = slideRoomHref(s.id);
  const more = href
    ? `<a href="${href}" class="hroom-more" style="display:inline-block;margin-top:8px;color:var(--gold);font-size:.72rem;letter-spacing:1.2px;text-transform:uppercase;font-weight:700;text-decoration:none;border-bottom:1px solid rgba(var(--gold-rgb),.5);padding-bottom:2px;">View room details →</a>`
    : '';
  const rate = r.nightly.published
    ? `<p class="hroom-rate">${r.nightly.qualifier ? `<span class="hroom-from">${r.nightly.qualifier}</span>` : ''}<span class="hroom-amt">${r.nightly.price}</span><span class="hroom-per">/ night</span></p>`
    : `<p class="hroom-rate hroom-rate--call"><span class="hroom-amt hroom-amt--call">${r.nightly.price}</span></p>`;
  return ` <article class="hroom" data-slide="${i}" aria-hidden="true">
   <div class="hroom-id">
    <p class="hroom-kicker">${r.sleeps}</p>
    <h2 class="hroom-name">${r.name}</h2>
    <ul class="hroom-feats">${r.features.map((f) => `<li>${f}</li>`).join('')}</ul>
   </div>
   <div class="hroom-price">
    ${rate}
    <p class="hroom-fine">${r.nightly.note}</p>
   </div>
   <div class="hroom-act">
    <p class="hroom-weekly">${r.weekly}</p>
    ${r.footnote ? `<p class="hroom-foot">${r.footnote}</p>` : ''}
    <a href="tel:${BUSINESS.phoneTel}" class="hroom-cta" data-track="phone_call_homepage">Book Now · ${BUSINESS.phoneDisplay}</a>
    ${more}
   </div>
  </article>`;
}).join('\n')}
 </div>

 <!-- Controls sit as one row at the bottom centre: the left edge of the hero is
      taken by the "We're Open!" notice and the right by the pet badge, and both
      would swallow a vertically-centred arrow. -->
