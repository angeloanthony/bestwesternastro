  rooms.forEach(c => {
    const on = Number(c.dataset.slide) === n;
    if (on) shown = true;
    c.classList.toggle('active', on);
    c.setAttribute('aria-hidden', on ? 'false' : 'true');
    const cta = c.querySelector('.hroom-cta');
    if (cta) cta.tabIndex = on ? 0 : -1;
  });
  if (heroEl) heroEl.classList.toggle('hero-has-room', shown);
}

function gs(n) {
  /* The one being shown and the one after it: dots and arrows can jump
     anywhere in the reel, not only forward one. */
  hpromote(n);
  hpromote((n + 1) % slides.length);
  slides[cs].classList.remove('active');
  dc.children[cs].classList.remove('active');
  dc.children[cs].setAttribute('aria-selected', 'false');
  cs = n;
  slides[cs].classList.add('active');
  dc.children[cs].classList.add('active');
  dc.children[cs].setAttribute('aria-selected', 'true');
  hcard(cs);
  const kb = slides[cs].querySelector('.hero-kb');
  if (hstill) { kb.style.transition = 'none'; kb.style.transform = 'scale(1)'; return; }
  kb.style.transition = 'none';
  kb.style.transform  = 'scale(' + hkbFrom() + ')';
  kb.offsetHeight;
  kb.style.transition = 'transform ' + (HOME_KB_MS / 1000) + 's ease-out';
  kb.style.transform  = 'scale(1)';
}

/* Slides after the first carry their photograph in data-bg rather than in a
   style attribute, so the browser does not open seven large downloads at once
   and leave the opening frame — the only one on screen — competing with six
   that are not. This turns one back into a real background-image. */
function hpromote(n) {
  const s = slides[n];
  if (!s) return;
  const kb = s.querySelector('.hero-kb');
  if (!kb || !kb.dataset.bg) return;
  /* Read at promotion time rather than once at load, so a phone rotated into
     landscape before the reel gets there still picks the wider frame. A slide
     with no portrait falls back to its landscape one. */
  const url = (hportrait.matches && kb.dataset.bgPortrait) || kb.dataset.bg;
  kb.removeAttribute('data-bg');
  kb.removeAttribute('data-bg-portrait');
  kb.style.backgroundImage = "url('" + url + "')";
}

function hstep(d)  { gs((cs + d + slides.length) % slides.length); }
function hstop()   { clearInterval(htimer); htimer = null; }
function hstart()  { if (!htimer && slides.length > 1) htimer = setInterval(() => hstep(1), HOME_HERO_MS); }
function hrestart(){ hstop(); hstart(); }

if (slides.length) {
  hcard(0);
  document.getElementById('hprev')?.addEventListener('click', () => { hstep(-1); hrestart(); });
  document.getElementById('hnext')?.addEventListener('click', () => { hstep(1);  hrestart(); });
  if (heroEl) {
    heroEl.addEventListener('mouseenter', hstop);
    heroEl.addEventListener('mouseleave', hstart);
    heroEl.addEventListener('focusin',  hstop);
    heroEl.addEventListener('focusout', hstart);
  }
  document.addEventListener('visibilitychange', () => { document.hidden ? hstop() : hstart(); });

  const kb0 = slides[0].querySelector('.hero-kb');
  /* Was a hardcoded 8s, left behind when the reel's timings became constants. */
  kb0.style.transition = hstill ? 'none' : 'transform ' + (HOME_KB_MS / 1000) + 's ease-out';
  kb0.style.transform  = 'scale(1)';

  /* Do not start counting until the opening photograph is actually on screen.
     The timer was always exact — measured, it fired at 3269, 6270 and 9270ms —
     but on anything slower than localhost the first two of those were spent on
     a frame with no picture in it yet, so the reel appeared to sit still and
     then race. A hold is meant to be 3s of a guest LOOKING at a room. */
  let hbegun = false;
  function hbegin() {
    if (hbegun) return;
    hbegun = true;
    hpromote(1);            // ready the frame the first advance will show
    hstart();
    /* The rest once the page has settled — none is needed for 6s yet. */
    const rest = () => { for (let i = 2; i < slides.length; i++) hpromote(i); };
    if (document.readyState === 'complete') setTimeout(rest, 0);
    else window.addEventListener('load', () => setTimeout(rest, 300), { once: true });
  }
  const probe = new Image();
  probe.onload = hbegin;
  probe.onerror = hbegin;   // a missing photograph must not stop the reel
  probe.src = (hportrait.matches && ${JSON.stringify(HERO_SLIDES[0].portrait ?? '')}) || hfirst;
  if (probe.complete) hbegin();
  setTimeout(hbegin, 5000); // and neither must a slow one
}

// Room Tabs
function st(btn,id){
  document.querySelectorAll('.tpanel').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.tbtn').forEach(b=>b.classList.remove('active'));
  document.getElementById('t-'+id).classList.add('active');
  btn.classList.add('active');
}

// Lightbox. The array is emitted from HOME_GALLERY, the same list the grid
// above renders, so a tile's ola(i) and imgs[i] are the same picture by
// construction. They were two hand-kept lists and had drifted: every room tile
// opened a different photograph. Do not re-inline this.
const imgs=${JSON.stringify(HOME_GALLERY.map((t) => ({ s: t.src, c: t.label })))};
let li=0;
/* solo holds a picture opened from somewhere OTHER than the gallery grid — the
   room tabs in #rooms call ol() with their own files, which are not in imgs.
   ol() used to findIndex and fall back to index 0 on a miss, so any such card
   opened the FIRST GALLERY PICTURE instead of the room you clicked. Now a miss
   shows the picture it was actually given, with the counter and the arrows
   stood down because a single picture has no sequence to step through. */
let solo=null;
function lbopen(){document.getElementById('lb').classList.add('open');document.body.style.overflow='hidden';}
function ola(i){solo=null;li=i;sl();lbopen();}
function ol(s,c){const i=imgs.findIndex(x=>x.s===s);if(i>=0){solo=null;li=i;}else{solo={s:s,c:c};}sl();lbopen();}
function sl(){
  const img=document.getElementById('lb-img');
  const it=solo||imgs[li];
  img.style.opacity=0;
  setTimeout(()=>{img.src=it.s;document.getElementById('lb-cap').textContent=it.c;document.getElementById('lbc').textContent=solo?'':(li+1)+' / '+imgs.length;img.style.opacity=1;},150);
}
function ln(d){if(solo)return;li=(li+d+imgs.length)%imgs.length;sl();}
function cl(){document.getElementById('lb').classList.remove('open');document.body.style.overflow='';}
document.getElementById('lb')?.addEventListener('click',function(e){if(e.target===this)cl();});
document.addEventListener('keydown',e=>{
  const lb=document.getElementById('lb');
  if(!lb||!lb.classList.contains('open'))return;
  if(e.key==='ArrowRight')ln(1);
  if(e.key==='ArrowLeft')ln(-1);
  if(e.key==='Escape')cl();
});

/* ── Owner Video Frame — YouTube embed ── */
const ownerOverlay = document.getElementById('ownerPlayOverlay');
const ownerIframe  = document.getElementById('ownerVideo');

if (ownerOverlay && ownerIframe) {
  ownerOverlay.addEventListener('click', () => {
    ownerIframe.contentWindow.postMessage(
      '{"event":"command","func":"playVideo","args":""}', '*'
    );
    ownerOverlay.style.opacity = '0';
    ownerOverlay.style.pointerEvents = 'none';
  });

  if (window.matchMedia('(hover: hover)').matches) {
    const ownerBox = document.getElementById('ownerFrameBox');
    const scene    = ownerBox.closest('.owner-frame-scene');
    scene.addEventListener('mousemove', e => {
      const r    = scene.getBoundingClientRect();
      const x    = (e.clientX - r.left)  / r.width  - 0.5;
      const y    = (e.clientY - r.top)   / r.height - 0.5;
      const rotY =  x * 14;
      const rotX = -y * 14;
      ownerBox.style.transform = \`rotateX(\${rotX}deg) rotateY(\${rotY}deg)\`;
    });
    scene.addEventListener('mouseleave', () => {
      ownerBox.style.transform = 'rotateX(2deg) rotateY(2deg)';
    });
  }
}
</script>`;
