import BaseLayout from '../layouts/BaseLayout.astro';
import { RATES, usd, perNight } from '../data/rates.ts';
import { BUSINESS } from '../data/business.ts';

const headExtras = `<script type="application/ld+json">
 {
  "@context":"https://schema.org",
  "@type":"FAQPage",
  "mainEntity":[
   {"@type":"Question","name":"What is the cheapest hotel in Vernal, Utah?","acceptedAnswer":{"@type":"Answer","text":"Best Western Vernal Inn offers rates starting at $84 per night with free hot breakfast, free parking, and free WiFi — making it the best overall value among full-service hotels in Vernal when total cost is considered."}},
    {"@type":"Question","name":"Do you offer weekly rates?","acceptedAnswer":{"@type":"Answer","text":"Yes. Weekly rates start at ${usd(RATES.weekly.standardQueen)} for 7 nights in a Standard Queen room and ${usd(RATES.weekly.doubleQueen)} for a Double Queen room. All weekly rates include free breakfast and all standard amenities."}},
    {"@type":"Question","name":"Is breakfast really free?","acceptedAnswer":{"@type":"Answer","text":"Yes. A full hot breakfast is included every morning with every stay — eggs, waffles, pastries, fruit, coffee, and juice. No additional charge."}},
    {"@type":"Question","name":"Are there any hidden fees?","acceptedAnswer":{"@type":"Answer","text":"No. No resort fees, parking fees, WiFi charges, or other hidden costs. The rate you see is the rate you pay."}},
    {"@type":"Question","name":"Do you offer per-diem rates for oilfield workers?","acceptedAnswer":{"@type":"Answer","text":"Yes. Weekly and monthly rates are designed to fit standard GSA per diem rates for Uintah County. Call (435) 789-6625 for current per-diem pricing."}}
  ]
 }
 </script>`;
const bodyContent = `<section class="page-hero">
 <div class="page-hero-cnt">
 <p style="font-size:.85rem;letter-spacing:3px;text-transform:uppercase;margin-bottom:12px;color:var(--gold);font-weight:700;">Vernal's Best Value — Real Amenities, Real Savings</p>
 <h1 style="font-family:'Playfair Display',serif;font-size:clamp(1.8rem,4.5vw,3rem);font-weight:700;margin-bottom:18px;line-height:1.15;">Affordable Hotel<br>in Vernal, Utah</h1>
 <p style="font-size:1.05rem;line-height:1.7;opacity:.88;max-width:620px;margin:0 auto 24px;font-weight:300;">Looking for a budget-friendly hotel in Vernal that doesn't cut corners? Best Western Vernal Inn starts at ${perNight(RATES.weekly.standardQueen)}/night with free hot breakfast, free parking, free WiFi, and kitchenettes — amenities that save you $50+ per day versus hotels that charge for everything extra.</p>
 <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
  <a href="tel:${BUSINESS.phoneTel}" style="background:var(--gold);color:var(--navy);padding:13px 32px;border-radius:4px;text-decoration:none;font-weight:900;font-size:.85rem;letter-spacing:1.5px;text-transform:uppercase;">📞 ${BUSINESS.directBooking.ctaLabel} ${BUSINESS.directBooking.discountPercent}%</a>
  <a href="tel:${BUSINESS.phoneTel}" style="border:2px solid #fff;color:#fff;padding:12px 28px;border-radius:4px;text-decoration:none;font-weight:700;font-size:.85rem;letter-spacing:1px;">📞 (435) 789-6625</a>
 </div>
 </div>
</section>
<div class="distance-bar">💰 NIGHTLY FROM $84 · WEEKLY FROM ${usd(RATES.weekly.standardQueen)} · FREE BREAKFAST ALWAYS INCLUDED</div>
<div class="content-wrap">
<div class="intro-pull"><strong>Budget-friendly doesn't have to mean bare-bones.</strong> Best Western Vernal Inn offers the lowest effective nightly cost of any full-service hotel in Vernal when you factor in what's included: free hot breakfast saves $10–$15 per person per day, free parking saves $10–$15/night versus competitors that charge, free WiFi is standard, and kitchenettes in select rooms let you cook instead of eating out. For a weekly stay, our ${usd(RATES.weekly.standardQueen)} rate works out to ${perNight(RATES.weekly.standardQueen)}/night all-in — a rate no comparable Vernal hotel can match with the same amenity package.</div>
<div class="content-section">
 <h2>What's Included — No Hidden Fees</h2>
<p>The real cost of a hotel isn't just the room rate — it's what you pay on top. At Best Western Vernal Inn, everything that matters is already included. No resort fees, no parking charges, no WiFi upcharges, no surprises on the bill. Here's exactly what you get with every single stay, whether it's one night or one month:</p>
<ul class="feat-list">
 <li>Free hot breakfast daily — eggs, waffles, coffee, juice, pastries</li>
 <li>Free WiFi throughout the entire property</li>
 <li>Free parking — trucks, trailers, and oversized vehicles welcome</li>
 <li>Full kitchenettes in select rooms — cook your own meals</li>
 <li>Pet friendly rooms — no need to board your dog</li>
 <li>Jacuzzi suites available for a small upgrade</li>
 <li>On-site laundry facilities</li>
 <li>24-hour front desk — check in on your schedule</li>
</ul>
</div>
<div class="content-section">
 <h2>Compare the Total, Not the Advertised Rate</h2>
<p>The lowest nightly rate in town is not always the lowest cost of the trip. Four things move the total, and only one of them is the room rate. We publish what ours are rather than guessing at anyone else's — check each of these against whatever you are comparing us to:</p>
<ul class="feat-list">
 <li><strong>The room rate itself.</strong> Ours is ${usd(RATES.weekly.standardQueen)} for a Standard Queen week (${perNight(RATES.weekly.standardQueen)}/night, ${RATES.taxNote}). Full pricing is on the <a href="/weekly-hotel-rates-vernal-utah" style="color:var(--navy);font-weight:700;">weekly rates page</a>.</li>
 <li><strong>Breakfast.</strong> Included here, every morning, for every guest. Where it is not included, cost it per person per morning and add it — for a family staying several nights, it is rarely a small number.</li>
 <li><strong>Parking.</strong> Free here, including trucks and trailers. Ask whether it is free, whether it is charged nightly, and whether an oversized vehicle is allowed at all.</li>
 <li><strong>Whether you can cook.</strong> A kitchenette does not save anything on the room; it changes how many meals you buy. The longer the stay, the more this dominates everything else on the list.</li>
</ul>
<p>Add booking fees to that list if you are reserving through a third-party site. Booking direct on ${BUSINESS.phoneDisplay} has none, and the code <strong>${BUSINESS.directBooking.promoCode}</strong> takes ${BUSINESS.directBooking.discountPercent}% off.</p>
</div>
<div class="content-section">
 <h2>Who Chooses Best Western Vernal Inn for Value</h2>
<p>Our affordable rates attract a wide range of guests — from oilfield workers on GSA per diem to road-tripping families to hunters who want a real bed during rifle season. The common thread is practical people who do the math and realize that free breakfast, free parking, and a kitchenette add up to real savings over the course of a stay.</p>
<ul class="feat-list">
 <li>Oilfield workers and contractors on per diem — check the current GSA rate for Uintah County, then call us with it</li>
 <li>Families visiting Dinosaur National Monument — save on food costs</li>
 <li>Hunting groups during fall season — weekly rate for the full hunt</li>
 <li>Road trippers on Highway 40 — stop, rest, refuel, save</li>
 <li>Business travelers — all-in pricing with no surprise charges</li>
 <li>Extended-stay guests relocating to the Uintah Basin</li>
</ul>
</div>
<div class="pro-tip"><p><strong>Budget Tip:</strong> A family of four staying 3 nights at ${perNight(RATES.weekly.standardQueen)}/night with free breakfast and a kitchenette saves roughly $100–$200 compared to a $135/night hotel without breakfast or kitchen. For a full week at ${usd(RATES.weekly.standardQueen)}, the savings are even larger. Call (435) 789-6625 to book.</p></div>
<div class="content-section">
 <h2>Frequently Asked Questions</h2>
 <details style="border-bottom:1px solid #e8e4dc;padding:1rem 0;">
  <summary style="font-weight:700;color:var(--navy);cursor:pointer;font-size:1.02rem;">What is the cheapest hotel in Vernal, Utah?</summary>
  <p style="margin-top:.7rem;color:var(--muted);line-height:1.8;font-weight:300;">Best Western Vernal Inn offers rates starting at $84 per night with free hot breakfast, free parking, and free WiFi — making it the best overall value among full-service hotels in Vernal when total cost is considered.</p>
 </details>
 <details style="border-bottom:1px solid #e8e4dc;padding:1rem 0;">
  <summary style="font-weight:700;color:var(--navy);cursor:pointer;font-size:1.02rem;">Do you offer weekly rates?</summary>
  <p style="margin-top:.7rem;color:var(--muted);line-height:1.8;font-weight:300;">Yes. Weekly rates start at ${usd(RATES.weekly.standardQueen)} for 7 nights in a Standard Queen room and ${usd(RATES.weekly.doubleQueen)} for a Double Queen room. All weekly rates include free breakfast and all standard amenities.</p>
 </details>
 <details style="border-bottom:1px solid #e8e4dc;padding:1rem 0;">
  <summary style="font-weight:700;color:var(--navy);cursor:pointer;font-size:1.02rem;">Is breakfast really free?</summary>
  <p style="margin-top:.7rem;color:var(--muted);line-height:1.8;font-weight:300;">Yes. A full hot breakfast is included every morning with every stay — eggs, waffles, pastries, fruit, coffee, and juice. No additional charge.</p>
 </details>
 <details style="border-bottom:1px solid #e8e4dc;padding:1rem 0;">
  <summary style="font-weight:700;color:var(--navy);cursor:pointer;font-size:1.02rem;">Are there any hidden fees?</summary>
  <p style="margin-top:.7rem;color:var(--muted);line-height:1.8;font-weight:300;">No. No resort fees, parking fees, WiFi charges, or other hidden costs. The rate you see is the rate you pay.</p>
 </details>
 <details style="border-bottom:1px solid #e8e4dc;padding:1rem 0;">
  <summary style="font-weight:700;color:var(--navy);cursor:pointer;font-size:1.02rem;">Do you offer per-diem rates for oilfield workers?</summary>
  <p style="margin-top:.7rem;color:var(--muted);line-height:1.8;font-weight:300;">Yes. Weekly and monthly rates are designed to fit standard GSA per diem rates for Uintah County. Call (435) 789-6625 for current per-diem pricing.</p>
 </details>
</div>
