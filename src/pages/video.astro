const pageScripts = `<script>
/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   PRESENTATION ENGINE
â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */

const scenes      = Array.from(document.querySelectorAll('.scene'));
const totalScenes = scenes.length;
let current  = 0;
let playing  = false;
let ticker   = null;
let elapsed  = 0;
let speedMul = 1;

const durations = scenes.map(s => parseInt(s.dataset.duration) || 6);
const totalDur  = durations.reduce((a,b) => a+b, 0);

const sceneStarts = [];
let acc = 0;
durations.forEach(d => { sceneStarts.push(acc); acc += d; });

/* â”€â”€ Loader â”€â”€ */
const lbar = document.getElementById('lbar');
let lp = 0;
const lInter = setInterval(() => {
 lp += Math.random() * 18;
 if (lp >= 100) { lp = 100; clearInterval(lInter); setTimeout(() => { document.getElementById('loader').classList.add('done'); }, 300); }
 lbar.style.width = lp + '%';
}, 120);

/* â”€â”€ Build thumbnails â”€â”€ */
const thumbStrip = document.getElementById('thumbStrip');
scenes.forEach((s, i) => {
 const bg = s.querySelector('.scene-bg').style.backgroundImage;
 const url = bg.replace(/url\\(['"]?(.*?)['"]?\\)/, '$1');
 const div = document.createElement('div');
 div.className = 'thumb' + (i === 0 ? ' active' : '');
 div.innerHTML = \`<img src="\${url}" alt="Scene \${i+1}">\`;
 div.onclick = () => goScene(i);
 thumbStrip.appendChild(div);
});

/* â”€â”€ Chapter dots on progress bar â”€â”€ */
const ptrack = document.getElementById('progress-track');
sceneStarts.slice(1).forEach(st => {
 const dot = document.createElement('div');
 dot.className = 'chapter-dot';
 dot.style.left = (st / totalDur * 100) + '%';
 ptrack.appendChild(dot);
});

function goScene(n, autoPlay = true) {
 if (n < 0 || n >= totalScenes) return;
 scenes[current].classList.remove('active');
 document.querySelectorAll('.thumb')[current].classList.remove('active');
 current = n;
 elapsed = 0;
 scenes[current].classList.add('active');
 document.querySelectorAll('.thumb')[current].classList.add('active');
 const bg = scenes[current].querySelector('.scene-bg');
 bg.style.transition = 'none';
 bg.offsetHeight;
 bg.style.transition = \`transform \${durations[current] / speedMul}s ease-out\`;
 bg.style.transform = 'scale(1)';
 document.getElementById('scene-label').textContent = scenes[current].dataset.label;
 if (autoPlay && !playing) startPlay();
 updateProgress();
}

function updateProgress() {
 const globalElapsed = sceneStarts[current] + elapsed;
 const pct = (globalElapsed / totalDur) * 100;
 document.getElementById('progress-fill').style.width = pct + '%';
 document.getElementById('cur-time').textContent = fmt(globalElapsed);
 document.getElementById('tot-time').textContent = fmt(totalDur);
}

function fmt(s) {
 const m = Math.floor(s / 60);
 const sec = Math.floor(s % 60);
 return \`\${m}:\${sec.toString().padStart(2,'0')}\`;
}

function startPlay() {
 if (playing) return;
 playing = true;
 document.getElementById('play-pause').textContent = 'â¸';
 ticker = setInterval(tick, 250);
}
function pausePlay() {
 if (!playing) return;
 playing = false;
 document.getElementById('play-pause').textContent = 'â–¶';
 clearInterval(ticker);
}
function togglePlay() {
 playing ? pausePlay() : startPlay();
}

function tick() {
 elapsed += 0.25 * speedMul;
 updateProgress();
 if (elapsed >= durations[current]) {
   elapsed = 0;
   if (current >= totalScenes - 1) {
     pausePlay();
     showOutro();
   } else {
     goScene(current + 1, true);
   }
 }
}

function showOutro() { document.getElementById('outro').classList.add('show'); }
function hideOutro() { document.getElementById('outro').classList.remove('show'); }

document.getElementById('btn-start').addEventListener('click', () => {
 document.getElementById('intro').classList.add('hide');
 goScene(0, true);
});

document.getElementById('play-pause').addEventListener('click', togglePlay);
document.getElementById('btn-prev').addEventListener('click', () => { goScene(Math.max(0, current - 1)); });
document.getElementById('btn-next').addEventListener('click', () => { goScene(Math.min(totalScenes-1, current+1)); });

document.getElementById('btn-replay').addEventListener('click', (e) => {
 e.preventDefault();
 hideOutro();
 goScene(0, true);
});

document.getElementById('btn-watch-video').addEventListener('click', (e) => {
 pausePlay();
 hideOutro();
 setTimeout(() => {
   document.getElementById('yt-hero').scrollIntoView({ behavior: 'smooth' });
 }, 150);
});

document.getElementById('progress-track').addEventListener('click', function(e) {
 const rect = this.getBoundingClientRect();
 const pct  = (e.clientX - rect.left) / rect.width;
 const targetTime = pct * totalDur;
 let si = 0;
 for (let i = sceneStarts.length - 1; i >= 0; i--) {
   if (targetTime >= sceneStarts[i]) { si = i; break; }
 }
 elapsed = targetTime - sceneStarts[si];
 if (current !== si) {
   scenes[current].classList.remove('active');
   document.querySelectorAll('.thumb')[current].classList.remove('active');
   current = si;
   scenes[current].classList.add('active');
   document.querySelectorAll('.thumb')[current].classList.add('active');
   document.getElementById('scene-label').textContent = scenes[current].dataset.label;
 }
 updateProgress();
 if (!playing) startPlay();
});

const speeds = [1, 1.5, 2, 0.75];
let speedIdx = 0;
document.getElementById('speed-btn').addEventListener('click', function() {
 speedIdx = (speedIdx + 1) % speeds.length;
 speedMul = speeds[speedIdx];
 this.textContent = speedMul + 'Ã—';
});

document.addEventListener('keydown', e => {
 if (e.target.tagName === 'INPUT') return;
 if (e.key === ' ')           { e.preventDefault(); togglePlay(); }
 if (e.key === 'ArrowRight')  { goScene(Math.min(totalScenes-1, current+1)); }
 if (e.key === 'ArrowLeft')   { goScene(Math.max(0, current-1)); }
 if (e.key === 'f' || e.key === 'F') { toggleFS(); }
});

function toggleFS() {
 if (!document.fullscreenElement) {
   document.getElementById('stage').requestFullscreen?.();
 } else {
   document.exitFullscreen?.();
 }
}
document.getElementById('btn-fs').addEventListener('click', toggleFS);

document.getElementById('stage').addEventListener('click', function(e) {
 const skip = ['controls','intro','outro','lbprev','lbnext'].some(id => {
   const el = document.getElementById(id);
   return el && el.contains(e.target);
 });
 if (!skip && !document.getElementById('intro').contains(e.target)
   && !document.getElementById('outro').contains(e.target)) {
   togglePlay();
 }
});

window.addEventListener('load', () => {
 scenes[0].classList.add('active');
});

let touchX = 0;
document.getElementById('stage').addEventListener('touchstart', e => { touchX = e.touches[0].clientX; });
document.getElementById('stage').addEventListener('touchend', e => {
 const dx = e.changedTouches[0].clientX - touchX;
 if (Math.abs(dx) > 50) dx < 0 ? goScene(Math.min(totalScenes-1, current+1)) : goScene(Math.max(0, current-1));
});
</script>`;
