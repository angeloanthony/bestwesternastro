---
// src/components/Header.astro
// Shared top navigation + mobile slide menu. Markup is lifted verbatim
// from the legacy pages. The only legacy variation is on the home page,
// where the logo links to "#" and the Home link carries .nav-active;
// subpages link the logo and Home to index.html. The isHome prop
// reproduces that exactly.
import { BUSINESS } from '../data/business.ts';
import { ROOMS, roomHref } from '../data/rooms.ts';

// The dropdown lists every room from ROOMS, in that file's order — which is
// the same order the homepage rate table prints, cheapest first. Adding a room
// there puts it in the nav on the next build; there is no second list to keep
// in step. The rate comes from the same NightlyQuote the room page shows, and
// is only rendered when it is actually published, so an unpriced room would
// appear as a name alone rather than as a blank or a guess.
interface Props {
  isHome?: boolean;
}
const { isHome = false } = Astro.props;

const logoHref = isHome ? '#' : '/';
const homeClass = isHome ? 'nav-drop-trigger nav-active' : 'nav-drop-trigger';
---

<nav id="nav">
  <a class="nav-logo" href={logoHref}>
    <!-- TODO: Replace image asset -->
    <!-- Root-relative, NOT "images/logo.webp". Every nav link beside it is
         already root-relative; the logo was the one exception, and it only
         worked because every page lived at the site root. On a nested page it
         resolves against the directory — /rooms/studio-king asked for
         /rooms/images/logo.webp and got a 404 and a broken-image icon. -->
    <img src="/images/logo.webp" alt="Best Western Vernal Inn" class="nav-logo-img" />
    Best Western · Vernal
  </a>
  <ul class="nav-links">
    <li class="nav-drop-wrap">
      <a href="/" class={homeClass}>Home ▾</a>
      <ul class="nav-dropdown">
        <li><a href="/#rooms">🛏️ Rooms</a></li>
        <li><a href="/#gallery">🖼️ Gallery</a></li>
        <li><a href="/#amenities">✨ Amenities</a></li>
        <li><a href="/#location">📍 Location</a></li>
        <li class="nav-drop-sep" aria-hidden="true">Our Rooms</li>
        {ROOMS.map((r) => (
          <li>
            <a class="nav-drop-room" href={roomHref(r.slug)}>
              <span class="nav-drop-name">{r.shortName}</span>
              {r.nightly.published && <span class="nav-drop-rate">{r.nightly.price}</span>}
            </a>
          </li>
        ))}
      </ul>
    </li>
    <li><a href="/explore">Explore Vernal</a></li>
    <li><a href="/faq">FAQ</a></li>
    <li><a href="/video">▶ Our Story</a></li>
  </ul>
  <a class="nav-phone" href={`tel:${BUSINESS.phoneTel}`} data-track="phone_call_header"><strong>Book Directly</strong>📞 {BUSINESS.phoneDisplay}</a>
  <a class="nav-cta" href={`tel:${BUSINESS.phoneTel}`} data-track="phone_call_header">{BUSINESS.directBooking.ctaLabel} {BUSINESS.directBooking.discountPercent}%</a>
  <button class="burger" id="burger">
    <span></span><span></span><span></span>
  </button>
</nav>

<div class="mmenu" id="mm">
  <a href="/" onclick="cm()">Home</a>
  <a href="/#rooms" onclick="cm()">Rooms</a>
  {/* The same six rooms as the desktop dropdown — a phone had no way to reach
      a room page from the menu at all, because the dropdown is hover-only. */}
  <div class="mmenu-rooms">
    {ROOMS.map((r) => (
      <a href={roomHref(r.slug)} onclick="cm()">
        {r.shortName}
        {r.nightly.published && <span>{r.nightly.price}</span>}
      </a>
    ))}
  </div>
  <a href="/explore" onclick="cm()">Explore Vernal</a>
  <a href="/things-to-do-vernal-utah" onclick="cm()">Things to Do</a>
  <a href="/faq" style="color:var(--gold)">FAQ</a>
  <a href="/video" style="color:var(--gold)">▶ Our Story</a>
  <a href={`tel:${BUSINESS.phoneTel}`} data-track="phone_call_header" style="color:var(--gold)">{BUSINESS.directBooking.ctaLabel} {BUSINESS.directBooking.discountPercent}% →</a>
  <a href={`tel:${BUSINESS.phoneTel}`} data-track="phone_call_header" style="color:var(--gold);font-size:1.1rem;font-weight:900;letter-spacing:1px;">📞 {BUSINESS.phoneDisplay}</a>
</div>
